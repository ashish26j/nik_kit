# Nik_kiT env template. Copy to infra/.env and adjust as needed:
#   cp infra/env/.env.example infra/.env
# infra/.env is git-ignored and auto-loaded by docker compose. NEVER commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=true

# --- MySQL container (db service) ---
MYSQL_DATABASE=nikkit
MYSQL_USER=nikkit
MYSQL_PASSWORD=nikkit_pw
MYSQL_ROOT_PASSWORD=root_pw

# --- Django → MySQL connection (app service) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=nikkit
DB_USER=nikkit
DB_PASSWORD=nikkit_pw

# -- GITHUB PAT Token:
GITHUB_PAT_TOKEN=REPLACE_WITH_REAL_PAT_IN_infra_dot_env